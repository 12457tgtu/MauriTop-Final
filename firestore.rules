rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- DEFAULT DENY ALL ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'khyhajmr08@gmail.com') || 
        request.auth.uid == 'PqXqqCgdC1eYPz4HKHHLtDRejPD3'
      );
    }

    function isStaffMember() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.active == true
      );
    }

    function hasStaffRole(role) {
      return isOwner() || (
        isStaffMember() && 
        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == role
      );
    }

    function isAdmin() {
      return isOwner() || isStaffMember() || isUserRole('admin');
    }

    function isUserRole(role) {
       return isSignedIn() && 
              exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
              (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role ||
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.staffRole == role);
    }

    // --- SERVICES ---
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isOwner() || hasStaffRole('services_manager') || isUserRole('admin') || true;
    }

    // --- USERS ---
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      // Allow users to update their own profile, but prevent unauthorized role elevation
      allow update: if isOwner() || (
        isSignedIn() && 
        request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'staffRole', 'referralsCount', 'referralEarnings', 'isReferralRewarded', 'balance'])
      );
      allow delete: if isOwner();
    }

    // --- STAFF MEMBERS & ROLES (RBAC) ---
    match /staff/{staffId} {
      // Owner can read all, staff members can read their own assignment
      allow read: if isOwner() || (isSignedIn() && request.auth.uid == staffId);
      // ONLY the Owner can hire, fire, or modify staff roles
      allow write: if isOwner();
    }

    // --- AUDIT LOGS (IMMUTABLE SECURITY TRAIL) ---
    match /audit_logs/{logId} {
      // Owner can read full audit logs
      allow read: if isOwner();
      // Staff members and owner can log audit records
      allow create: if isSignedIn();
      // Audit logs can NEVER be updated or deleted by anyone
      allow update, delete: if false;
    }

    // --- ORDERS ---
    match /orders/{orderId} {
      // Users can read their own orders. Staff and Admin can read all.
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      // Users can create orders for themselves.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Orders managers and owner can update status/notes
      allow update: if isOwner() || hasStaffRole('orders_manager') || isUserRole('orders_manager') || isUserRole('admin');
      // ONLY the Owner can permanently delete order history
      allow delete: if isOwner();
    }

    // --- NOTIFICATIONS ---
    match /notifications/{notifId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() && 
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
      );
      allow delete: if isOwner() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // --- WITHDRAWALS ---
    match /withdrawals/{withdrawalId} {
      allow read: if isOwner() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner();
    }

    // --- KYC REQUESTS ---
    match /kyc_requests/{userId} {
      allow read: if isOwner() || hasStaffRole('orders_manager') || (isSignedIn() && request.auth.uid == userId);
      allow create, update: if isOwner() || hasStaffRole('orders_manager') || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isOwner();
    }

    // --- SETTINGS (GLOBAL & PAYMENT) ---
    match /settings/{docId} {
      allow read: if true;
      // Sensitive payment and system settings can only be altered by Owner or Admin
      allow write: if isOwner() || isUserRole('admin');
    }

    // --- POSTS / WHATSAPP OFFERS ---
    match /posts/{postId} {
      allow read: if true;
      allow write: if isOwner() || hasStaffRole('services_manager') || isUserRole('admin');
    }

    // --- ACTIVE VISITORS ---
    match /active_visitors/{sessionId} {
      allow read: if isAdmin();
      allow write: if true;
    }

  }
}
